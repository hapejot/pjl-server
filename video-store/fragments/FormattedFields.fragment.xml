<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:f="sap.ui.layout.form">
    <f:SimpleForm editable="false" layout="ResponsiveGridLayout" columnsL="3" columnsM="2">
        <f:content>
            <Label text="Größe"/>
            <Text text="{path: 'file_size', targetType: 'any', formatter: 'video.ext.Format.bytes'}"/>
            <Label text="Bitrate"/>
            <Text text="{path: 'bitrate', targetType: 'any', formatter: 'video.ext.Format.bitrate'}"/>
            <Label text="Dauer"/>
            <Text text="{path: 'duration_seconds', targetType: 'any', formatter: 'video.ext.Format.duration'}"/>
        </f:content>
    </f:SimpleForm>
</core:FragmentDefinition>
