{
  "compilerOptions": {
    "rootDir": "fiori-server/frontend",
    "outDir": "fiori-server/static",
    "module": "preserve",
    "moduleDetection": "legacy",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true
  },
  "include": ["fiori-server/frontend/**/*.ts"]
}
