<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!--
		Video-Player der Object Page (Custom Section der Erweiterung video-store,
		siehe ext/videos/Player.js). Ein HTML5-video-Element zeigt auf den same-origin Proxy
		/ext/video/stream/<ID>; die ID ist eine UUID und daher ohne Escaping sicher.
	-->
	<VBox class="sapUiSmallMargin">
		<core:HTML
			sanitize="false"
			content="{= ${ID} ? '&lt;video id=&quot;videoPlayer&quot; controls preload=&quot;metadata&quot; style=&quot;max-width:100%;&quot; src=&quot;/ext/video/stream/' + ${ID} + '&quot;&gt;&lt;/video&gt;' : '' }" />
	</VBox>
</core:FragmentDefinition>
